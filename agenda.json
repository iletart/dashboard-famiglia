var todoItems = [];
var todoPin = "";
var todoConnected = false;
var todoBusy = false;
var todoPollTimer = null;
var todoSyncError = false;

function todoCanEdit(){
  return todoConnected && !todoBusy;
}

function todoRequest(method, data, callback){
  var x = new XMLHttpRequest();
  var url = CONFIG.todoWorkerUrl;

  x.open(method, url, true);
  x.setRequestHeader("X-Todo-Pin", todoPin);

  if(method === "POST"){
    x.setRequestHeader("Content-Type", "application/json");
  }

  x.onreadystatechange = function(){
    if(x.readyState !== 4) return;

    var result = null;

    try {
      result = parseJson(x.responseText);
    } catch(e) {}

    if(x.status >= 200 && x.status < 300){
      callback(null, result);
    } else {
      callback(
        result && result.error ?
          result.error :
          "Errore HTTP " + x.status,
        result
      );
    }
  };

  x.onerror = function(){
    callback("Errore di connessione", null);
  };

  x.ontimeout = function(){
    callback("Timeout di connessione", null);
  };

  x.timeout = 20000;

  try {
    x.send(method === "POST" ? JSON.stringify(data) : null);
  } catch(e) {
    callback("Errore di invio richiesta", null);
  }
}

function todoConnect(){
	var pinInput = $("todoPinInput");
	var pin = pinInput ? pinInput.value : "";

	if(!pin){
	  try {
		pin = window.localStorage.getItem("todoPin") || "";
	  } catch(e) {}
	}

	if(!pin){
	  setText($("todoStatus"), "Inserisci il PIN.");
	  return;
	}

  todoPin = pin;
  todoBusy = true;

  setText($("syncStatus"), "Connessione in corso...");

  todoRequest("GET", null, function(err, data){
    todoBusy = false;

	if(err || !data || !data.items){
	  todoConnected = false;
	  todoPin = "";
	  
	    try {
		window.localStorage.removeItem("todoPin");
	  } catch(e) {}

	  var detail = data && data.detail ? data.detail : "";

	  setText(
		$("syncStatus"),
		"Connessione non riuscita: " +
		(err || "risposta non valida") +
		(detail ? " - " + detail : "")
	  );

	  return;
	}
	
	todoItems = data.items;
	todoConnected = true;
	todoSyncedAt = new Date();
	todoSyncError = false;
	updateTodoSyncLabel();
	
	var syncBox = $("syncBox");
	if(syncBox){
	  syncBox.style.display = "none";
	}

	try {
	  window.localStorage.setItem("todoPin", todoPin);
	} catch(e) {}

    renderTodo();

    if(pinInput){
      pinInput.style.display = "none";
    }

	var connectButton = $("todoConnectButton");
	if(connectButton){
	  connectButton.style.display = "none";
	}

	/* Barra aggiunta attività */
	var ctl = $("todoCtl");
	clear(ctl);

	var inp = mk("input");
	inp.id = "todoInput";
	inp.type = "text";
	inp.maxLength = 200;
	inp.placeholder = "Nuova attività";

	inp.onkeydown = function(ev){
	  ev = ev || window.event;
	  if(ev.keyCode === 13){
		todoAdd();
	  }
	};

	var add = mk("button", "", "Aggiungi");
	add.type = "button";
	add.onclick = todoAdd;

	ctl.appendChild(inp);
	ctl.appendChild(document.createTextNode(" "));
	ctl.appendChild(add);

	/* Mostra insieme i campi di inserimento */
	ctl.style.display = "";

	var taskCtl = $("taskCtl");
	if(taskCtl){
	  taskCtl.style.display = "";
	}

	todoSchedulePoll();
	initTasks();
  });
}

function todoSchedulePoll(){
  if(todoPollTimer){
    clearTimeout(todoPollTimer);
  }

  todoPollTimer = setTimeout(function(){
    if(!todoConnected || todoBusy) {
      todoSchedulePoll();
      return;
    }

    todoRequest("GET", null, function(err, data){
      if(!err && data && data.items){
        todoItems = data.items;
        todoSyncedAt = new Date();
        todoSyncError = false;

        updateTodoSyncLabel();
        updateTaskButtons();

        renderTodo();
        setText($("todoStatus"), "");
      } else {
        todoSyncError = true;

        updateTodoSyncLabel();
        updateTaskButtons();

        setText($("todoStatus"), "Sincronizzazione temporaneamente non disponibile.");
      }

      todoSchedulePoll();
    });
  }, 30000);
}

function todoChange(action, index, text){
  if(!todoConnected || todoBusy) return;

  var data = {
    action: action
  };

  if(action === "add"){
    data.text = text;
  } else {
    data.index = index;
  }

  todoBusy = true;
  renderTodo();
  setText($("todoStatus"), "Salvataggio...");

  todoRequest("POST", data, function(err, result){
    todoBusy = false;

    if(err || !result || !result.items){
      todoSyncError = true;
      updateTodoSyncLabel();
      updateTaskButtons();

      setText($("todoStatus"), "Salvataggio non riuscito: " + (err || "errore"));
      renderTodo();
      return;
    }

    todoItems = result.items;
    todoSyncedAt = new Date();
    todoSyncError = false;

    updateTodoSyncLabel();
    updateTaskButtons();

    renderTodo();
    setText($("todoStatus"), "");
  });
}

function todoAdd(){
  var inp = $("todoInput");
  if(!inp) return;

  var value = inp.value.replace(/^\s+|\s+$/g, "");

  if(!value) return;

  if(value.length > 200){
    setText($("todoStatus"), "Massimo 200 caratteri.");
    return;
  }

  todoChange("add", null, value);

  inp.value = "";
}

function todoToggle(i){
  todoChange("toggle", i);
}

function todoDel(i){
  todoChange("delete", i);
}

function renderTodo(){
  var box = $("todoList");
  var i;

  clear(box);

  for(i = 0; i < todoItems.length; i++){
    box.appendChild(todoRow(i));
  }

  if(!todoItems.length){
    box.appendChild(mk("div", "", "Nessuna attività."));
  }

  scheduleBoxAlignment();
}

function todoRow(i){
  var it = todoItems[i];
  var row = mk("div", "todo");

  var txt = mk(
    "span",
    it.done ? "todo-text done" : "todo-text",
    (i + 1) + ". " + it.text
  );

  row.appendChild(txt);

  if(todoConnected){
    var actions = mk("span", "todo-actions");

    var b = mk("button", "", "✓");
    b.type = "button";
    b.disabled = todoBusy;
    b.title = it.done ? "Segna come da fare" : "Segna come completata";

    b.onclick = function(){
      todoToggle(i);
    };

    var del = mk("button", "", "🗑");
    del.type = "button";
    del.disabled = todoBusy;
    del.title = "Elimina attività";

    del.onclick = function(){
      todoDel(i);
    };

    actions.appendChild(b);
    actions.appendChild(del);
    row.appendChild(actions);
  }

  return row;
}

function loadTodo(){
  var ctl = $("syncCtl");
  var st = $("syncStatus");

  clear(ctl);
  clear($("todoList"));

  var pinInput = mk("input");
  pinInput.id = "todoPinInput";
  pinInput.type = "password";
  pinInput.maxLength = 50;
  pinInput.placeholder = "PIN sincronizzazione";
  pinInput.autocomplete = "off";

  var connectButton = mk("button", "", "Connetti");
  connectButton.id = "todoConnectButton";
  connectButton.type = "button";
  connectButton.onclick = todoConnect;

  ctl.appendChild(pinInput);
  ctl.appendChild(document.createTextNode(" "));
  ctl.appendChild(connectButton);

  pinInput.onkeydown = function(ev){
    ev = ev || window.event;
    if(ev.keyCode === 13){
      todoConnect();
    }
  };

  var savedPin = "";

  try {
    savedPin = window.localStorage.getItem("todoPin") || "";
  } catch(e) {}

  if(savedPin){
    pinInput.value = savedPin;
    todoConnect();
  } else {
    setText(st, "Inserisci il PIN per collegare la dashboard.");
  }
}

