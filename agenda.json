function taskDateKey(offset){
  var now = toRome(new Date().getTime());
  var d = new Date(Date.UTC(
    now.getUTCFullYear(),
    now.getUTCMonth(),
    now.getUTCDate() + offset
  ));

  return d.getUTCFullYear() + "-" +
    p2(d.getUTCMonth() + 1) + "-" +
    p2(d.getUTCDate());
}

function taskDateLabel(offset){
  var giorni = ["dom", "lun", "mar", "mer", "gio", "ven", "sab"];
  var mesi = ["gen", "feb", "mar", "apr", "mag", "giu",
              "lug", "ago", "set", "ott", "nov", "dic"];

  var d = new Date();
  var now = toRome(new Date().getTime());

  d = new Date(Date.UTC(
    now.getUTCFullYear(),
    now.getUTCMonth(),
    now.getUTCDate() + offset
  ));

  return giorni[d.getUTCDay()] + " " +
    p2(d.getUTCDate()) + " " +
    mesi[d.getUTCMonth()];
}

function taskRequest(method, data, callback){
  var x = new XMLHttpRequest();
  var url = CONFIG.todoWorkerUrl + "?list=tasks";

  x.open(method, url, true);
  x.setRequestHeader("X-Todo-Pin", todoPin);

  if(method === "POST"){
    x.setRequestHeader("Content-Type", "application/json");
  }

  x.onreadystatechange = function(){
    if(x.readyState !== 4) return;

    var result = null;

    try {
      result = parseJson(x.responseText);
    } catch(e) {}

    if(x.status >= 200 && x.status < 300){
      callback(null, result);
    } else {
      callback(
        result && result.error ? result.error : "Errore HTTP " + x.status,
        result
      );
    }
  };

  x.onerror = function(){
    callback("Errore di connessione", null);
  };

  x.ontimeout = function(){
    callback("Timeout di connessione", null);
  };

  x.timeout = 20000;

  try {
    x.send(method === "POST" ? JSON.stringify(data) : null);
  } catch(e) {
    callback("Errore di invio richiesta", null);
  }
}

function selectTask(day){
  taskSel = day;
  updateTaskButtons();
  renderTasks();
}

function updateTaskButtons(){
  var days = ["ieri", "oggi", "domani"];
  var i;

  for(i = 0; i < days.length; i++){
    var el = $("tb-" + days[i]);
    if(el){
      el.className = days[i] === taskSel ? "sel" : "";
    }
  }

  $("taskDateTitle").innerHTML =
    "Task di " + taskDateLabel(TASK_OFF[taskSel]);

  var times = "";

  if(!todoConnected){
    times = "non connesso";
  } else if(taskSyncError){
    times = "sync error";
  } else if(taskSyncedAt !== null){
    times = "sync time: " +
      hhmmRome(taskSyncedAt.getTime());
  } else {
    times = "sync in attesa";
  }

  $("taskTimes").innerHTML = times;
}

function loadTasks(silent){
  if(!todoConnected){
    taskSyncError = false;
    updateTaskButtons();
    setText($("taskStatus"), "");
    return;
  }

  if(!silent){
    setText($("taskStatus"), "Caricamento...");
  }

  taskRequest("GET", null, function(err, data){
    if(err || !data || !data.days){
      taskSyncError = true;
      updateTaskButtons();

      if(!silent){
        setText($("taskStatus"), "Task non disponibili: " + (err || "risposta non valida"));
      }

      taskSchedulePoll();
      return;
    }

    taskDays = data.days;
    taskReady = true;
    taskSyncError = false;
    taskSyncedAt = new Date();

    renderTasks();
    updateTaskButtons();

    if(!silent){
      setText($("taskStatus"), "");
    }

    taskSchedulePoll();
  });
}

function taskSchedulePoll(){
  if(taskPollTimer !== null){
    clearTimeout(taskPollTimer);
  }

  taskPollTimer = setTimeout(function(){
    taskPollTimer = null;

    if(!todoConnected){
      return;
    }

    if(taskBusy){
      taskSchedulePoll();
      return;
    }

    loadTasks(true);
  }, 30000);
}

function renderTasks(){
  updateTaskButtons();

  var list = $("taskList");
  clear(list);

  if(!taskReady){
    return;
  }

  var key = taskDateKey(TASK_OFF[taskSel]);
  var items = taskDays[key] || [];
  var i;

  for(i = 0; i < items.length; i++){
    list.appendChild(taskRow(i, items[i]));
  }

  if(!items.length){
    list.appendChild(mk("div", "", "Nessuna attività."));
  }

  scheduleBoxAlignment();
}

function taskRow(index, item){
  var row = mk("div", "todo");

  var txt = mk(
    "span",
    item.done ? "todo-text done" : "todo-text",
    (index + 1) + ". " + item.text
  );

  row.appendChild(txt);

  var actions = mk("span", "todo-actions");

  var b = mk("button", "", "✓");
  b.type = "button";
  b.disabled = taskBusy;
  b.title = item.done ? "Segna come da fare" : "Completa";

  b.onclick = function(){
    changeTask("toggle", index);
  };

  var del = mk("button", "", "🗑");
  del.type = "button";
  del.disabled = taskBusy;
  del.title = "Elimina attività";

  del.onclick = function(){
    changeTask("delete", index);
  };

  actions.appendChild(b);
  actions.appendChild(del);
  row.appendChild(actions);

  return row;
}

function changeTask(action, index, text){
  if(!taskReady || taskBusy) return;

  var key = taskDateKey(TASK_OFF[taskSel]);

  var data = {
    action: action,
    date: key
  };

  if(action === "add"){
    data.text = text;
  } else {
    data.index = index;
  }

  taskBusy = true;
  renderTasks();
  setText($("taskStatus"), "Salvataggio...");

  taskRequest("POST", data, function(err, result){
    taskBusy = false;

    if(err || !result || !result.days){
      taskSyncError = true;
      updateTaskButtons();

      setText($("taskStatus"), "Salvataggio non riuscito: " + (err || "errore"));

      taskSchedulePoll();
      return;
    }

    taskDays = result.days;
    taskSyncedAt = new Date();
    taskSyncError = false;

    renderTasks();
    updateTaskButtons();

    setText($("taskStatus"), "Task sincronizzati.");

    taskSchedulePoll();
  });
}

function addTask(){
  var inp = $("taskInput");
  if(!inp) return;

  var value = inp.value.replace(/^\s+|\s+$/g, "");

  if(!value) return;

  if(value.length > 200){
    setText($("taskStatus"), "Massimo 200 caratteri.");
    return;
  }

  changeTask("add", null, value);
  inp.value = "";
}

function initTasks(){
  var inp = $("taskInput");
  var add = $("taskAddButton");

  inp.onkeydown = function(ev){
    ev = ev || window.event;
    if(ev.keyCode === 13){
      addTask();
    }
  };

  add.onclick = addTask;

  $("tb-ieri").onclick = function(){
    selectTask("ieri");
  };

  $("tb-oggi").onclick = function(){
    selectTask("oggi");
  };

  $("tb-domani").onclick = function(){
    selectTask("domani");
  };

  updateTaskButtons();
  loadTasks();
}

/* ===== MENU SCUOLA ===== */
var MENUF = {ieri: "menu-ieri.json", oggi: "menu.json", domani: "menu-domani.json"};
var MENUOFF = {ieri: -1, oggi: 0, domani: 1};
var menuSel = "oggi";
var SKIP = /^(date|data|giorno|day|id|generated_at|updated|updated_at|url|link|scuola|school|centro|center|plesso|sede|nome_scuola|nome_centro)$/i;
function collectMenu(d){
  var out = [];
  if(!d || !d.plates){ return out; }

  for(var i = 0; i < d.plates.length; i++){
    var p = d.plates[i];

    if(typeof p === "string"){
      if(p){ out.push(p); }
    } else if(p){
      var name = p.name || p.description;
      if(name){ out.push(name); }
    }
  }

  return out;
}

function selectMenu(k){ menuSel = k; updateMenuButtons(); loadMenu(); }

function updateMenuButtons(){
  var ks = ["ieri", "oggi", "domani"], i;
  for(i = 0; i < ks.length; i++){ $("mb-" + ks[i]).className = (ks[i] === menuSel) ? "sel" : ""; }
}


function loadMenu() {
  var k = menuSel;

  // Calcola il giorno effettivamente selezionato
  var selectedDay = todayNum() + MENUOFF[k];
  var selectedDate = dateOfDayNum(selectedDay);
  var day = selectedDate.getUTCDay();

  // Se il giorno selezionato è sabato o domenica
  if (day === 0 || day === 6) {
    renderMenuWeekend();
    return;
  }

  setText($("menuStatus"), "Caricamento...");

  getJson([CONFIG.base + MENUF[k], MENUF[k]], function(err, d) {
    if (k !== menuSel) {
      return;
    }

    if (!err && d) {
      menuSyncedAt = new Date();
      menuUpdatedAt = parseIso(
        d.generated_at || d.updated_at
      );
    }

    safe(function() {
      renderMenu(k, err, d);
    });
  });
}

function renderMenuWeekend(){
  var phrases = [
    "Evviva! Oggi niente scuola: si gioca!",
    "Sabato: missione divertimento attivata!",
    "Domenica: vietato svegliarsi di fretta!",
    "Oggi il menu prevede giochi, risate e coccole!",
    "La scuola riposa, i bambini no!",
    "Weekend! Due giorni da piccoli campioni!",
    "Oggi la maestra è in vacanza… e anche noi!",
    "Niente mensa: oggi comanda la fantasia!",
    "Attenzione: piccolo esploratore in libertà!",
    "Oggi si mangia, si gioca e si fa festa!",
    "Weekend: abbracci extra e compiti zero!",
    "La scuola può aspettare: oggi si fa baldoria!"
  ];

  var list = $("menuList");
  clear(list);

  setText($("menuDate"), "");
  setText($("menuStatus"), "");

  var buttons = ["mb-ieri", "mb-oggi", "mb-domani", "mb-refresh"];
  var i, el;

  for(i = 0; i < buttons.length; i++){
    el = $(buttons[i]);
    if(el){
      el.style.display = "";
    }
  }

  updateMenuButtons();

  var phrase = phrases[Math.floor(Math.random() * phrases.length)];
  var message = mk("div", "weekend-message", phrase);

  list.appendChild(message);

  scheduleBoxAlignment();
}

function renderMenu(k, err, d){
  var list = $("menuList"), i;
  clear(list);

  $("menuTitle").innerHTML = "MENU SCUOLA";

  var times = "";

  if(menuUpdatedAt !== null){
    times += "upd time: " + hhmmRome(menuUpdatedAt) + "<br>";
  }

  if(menuSyncedAt !== null){
    times += "sync time: " +
      hhmmRome(menuSyncedAt.getTime());
  }

  if(err){
    times += "<br>sync error";
  }

  $("menuTimes").innerHTML = times;

  var label = fullDateText(todayNum() + MENUOFF[k]);
  setText($("menuDate"), label);

  var buttons = ["mb-ieri", "mb-oggi", "mb-domani", "mb-refresh"];

  for(i = 0; i < buttons.length; i++){
    var el = $(buttons[i]);
    if(el){
      el.style.display = "";
    }
  }

  updateMenuButtons();

  if(err){
    setText(list, "Menu non disponibile.");
    setText($("menuStatus"), "File non raggiungibile.");
    scheduleBoxAlignment();
    return;
  }

  var dishes = collectMenu(d);

  if(!dishes.length){
    setText(list, "Menu non disponibile per questo giorno.");
    setText($("menuStatus"), "");
    scheduleBoxAlignment();
    return;
  }

  var ul = mk("ul");

  for(i = 0; i < dishes.length; i++){
    ul.appendChild(mk("li", "", dishes[i]));
  }

  list.appendChild(ul);

  var now = toRome(new Date().getTime());

  setText(
    $("menuStatus"),
    "Caricato alle " +
    p2(now.getUTCHours()) + ":" +
    p2(now.getUTCMinutes())
  );

  scheduleBoxAlignment();
}


/* ===== AVVIO: ogni blocco è indipendente ===== */
if(IS_KINDLE){ document.body.className = "k"; }
safe(updateClock);
safe(loadAgenda);
safe(loadWeather);
safe(loadSunTimes);
safe(loadRoutes);
safe(loadMenu);
safe(loadTodo);
safe(updateMenuButtons);

initTasks();
startDailyUpdates();

setInterval(function(){
  safe(loadSunTimes);
}, 3600000);

function alignBottomBoxes(){

  /* Sul cellulare non allineare i riquadri */
  if(window.innerWidth <= 560){
    var allBoxes = document.querySelectorAll(".box");
    for(var n = 0; n < allBoxes.length; n++){
      allBoxes[n].style.minHeight = "";
    }
    return;
  }

  var cols = document.querySelectorAll(".col");
  var i, j, boxes, last;
  var heights = [];
  var maxHeight = 0;

  /* Azzera le altezze precedenti */
  for(i = 0; i < cols.length; i++){
    boxes = cols[i].querySelectorAll(".box");

    for(j = 0; j < boxes.length; j++){
      boxes[j].style.minHeight = "";
    }
  }

  /* Misura le colonne */
  for(i = 0; i < cols.length; i++){
    heights[i] = cols[i].offsetHeight;

    if(heights[i] > maxHeight){
      maxHeight = heights[i];
    }
  }

  /* Allunga l'ultimo riquadro della colonna più corta */
  for(i = 0; i < cols.length; i++){
    var diff = maxHeight - heights[i];

    if(diff > 0){
      boxes = cols[i].querySelectorAll(".box");

      if(boxes.length){
        last = boxes[boxes.length - 1];
        last.style.minHeight = (last.offsetHeight + diff) + "px";
      }
    }
  }
}

function scheduleBoxAlignment(){
  setTimeout(alignBottomBoxes, 100);
}

window.onresize = function(){
  alignBottomBoxes();
};


window.setTimeout(alignBottomBoxes, 500);
window.setTimeout(alignBottomBoxes, 2000);

</script>
